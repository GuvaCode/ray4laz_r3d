// r3d_importer.inc -- R3D Importer Module.


// ========================================
// ENUMS TYPES
// ========================================

type
  {*
   * Flags controlling importer behavior.
   * These flags define how the importer processes the source asset.

   * A sensible baseline of post-processing (triangulation, UV generation,
   * tangent space, etc.) is always applied regardless of these flags;
   * they only control situational behavior.
   *}
  R3D_ImportFlags = cuint32;

const
  {*
   * Keep a CPU-side copy of mesh data.
   * When enabled, raw mesh data is preserved in RAM after model import and
   * stored in @c meshData. Required if you need CPU-side access to geometry
   * after import, e.g. for collision detection or custom mesh processing.
   *}
  R3D_IMPORT_RETAIN_MESH_DATA    = 1 shl 0;

  {*
   * Import and store mesh names from the model file.
   * When enabled, mesh names are retrieved during import and stored in
   * @c meshNames. Useful for debugging, logging, or looking up a specific
   * mesh by name at runtime.
   *}
  R3D_IMPORT_RETAIN_MESH_NAMES   = 1 shl 1;

  {*
   * Generate smooth normals for meshes that lack them.
   * Existing normals are always preserved as-is. For meshes without normals,
   * flat (per-face) normals are generated by default; enabling this flag
   * generates smooth normals instead.
   *}
  R3D_IMPORT_SMOOTH_NORMALS      = 1 shl 2;

  {*
   * Optimize mesh topology for runtime rendering.
   * When enabled, indices are reordered to improve GPU vertex cache usage,
   * and overly large meshes are split into smaller ones. This increases
   * import time but can improve rendering performance.
   * Recommended for assets baked offline or imported in an editor; usually
   * unnecessary for quick runtime loading.
   *}
  R3D_IMPORT_OPTIMIZE_MESH       = 1 shl 3;

  {*
   * Validate mesh data and detect degenerate geometry.
   * When enabled, the importer checks for and flags degenerate triangles
   * and invalid data (e.g. malformed normals or UVs). Useful for catching
   * broken assets early, but adds extra processing time.
   *}
  R3D_IMPORT_VALIDATE_DATA       = 1 shl 4;

  {*
   * Enable high-quality import processing.
   * Shortcut combining @c R3D_IMPORT_SMOOTH_NORMALS, @c R3D_IMPORT_OPTIMIZE_MESH
   * and @c R3D_IMPORT_VALIDATE_DATA. Intended for editor usage and offline
   * asset processing, where import time matters less than mesh quality
   * and correctness.
   * When disabled, a faster import path is used, better suited for runtime
   * loading.
   *}
  R3D_IMPORT_QUALITY = R3D_IMPORT_SMOOTH_NORMALS or R3D_IMPORT_OPTIMIZE_MESH or R3D_IMPORT_VALIDATE_DATA;


// ========================================
// STRUCTS TYPES
// ========================================

type
  {*
   * Opaque importer handle.
   * Represents a loaded asset file that can be used to extract multiple
   * resources (models, skeletons, animations) without re-importing the file.
   *}
  PR3D_Importer = ^TR3D_Importer;
  TR3D_Importer = record
    { Internal structure - opaque }
  end;

// ========================================
// PUBLIC API
// ========================================

{*
 * @brief Load an importer from a file.
 *
 * Creates an importer instance from the specified file path.
 * The file is parsed once and can be reused to extract multiple
 * resources such as models and animations.
 *
 * @param filePath Path to the asset file.
 * @param flags Importer behavior flags.
 *
 * @return Pointer to a new importer instance, or NULL on failure.
 *}
function R3D_LoadImporter(const filePath: PChar; flags: R3D_ImportFlags): PR3D_Importer;
  cdecl; external {$IFNDEF RAY_STATIC}r3dName{$ENDIF} name 'R3D_LoadImporter';

{*
 * @brief Load an importer from a memory buffer.
 *
 * Creates an importer instance from in-memory asset data.
 * This is useful for embedded assets or streamed content.
 *
 * @param data Pointer to the asset data.
 * @param size Size of the data buffer in bytes.
 * @param hint Optional file format hint (may be NULL).
 * @param flags Importer behavior flags.
 *
 * @return Pointer to a new importer instance, or NULL on failure.
 *}
function R3D_LoadImporterFromMemory(const data: Pointer; size: cuint; const hint: PChar; flags: R3D_ImportFlags): PR3D_Importer;
  cdecl; external {$IFNDEF RAY_STATIC}r3dName{$ENDIF} name 'R3D_LoadImporterFromMemory';

{*
 * @brief Destroy an importer instance.
 *
 * Frees all resources associated with the importer.
 * Any models or animations extracted from it remain valid.
 *
 * @param importer Importer instance to destroy.
 *}
procedure R3D_UnloadImporter(importer: PR3D_Importer);
  cdecl; external {$IFNDEF RAY_STATIC}r3dName{$ENDIF} name 'R3D_UnloadImporter';
